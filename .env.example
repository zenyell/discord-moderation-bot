# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
GUILD_ID=your_test_guild_id          # Server ID — required for instant slash command sync
AUTO_ROLE_ID=                        # Optional: role ID to auto-assign on join
BAD_WORDS=badword1,badword2

# ── Spam settings ─────────────────────────────────────────────────────────────
SPAM_MESSAGE_LIMIT=6
SPAM_WINDOW_SECONDS=8
SPAM_TIMEOUT_MINUTES=5

# ── Database (Turso) ──────────────────────────────────────────────────────────
# Both are REQUIRED. Get them from https://turso.tech
TURSO_URL=libsql://your-db-name-yourorg.turso.io
TURSO_TOKEN=your_turso_auth_token_here

# ── Dashboard (Flask) ─────────────────────────────────────────────────────────
DATABASE_PATH=bot_data.db
FLASK_SECRET_KEY=replace_me_with_a_random_secret
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# ── Discord OAuth (for dashboard login) ───────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/callback
