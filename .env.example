# ── Flask ───────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-random-secret

# ── Discord Bot ─────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here

# ── Discord OAuth2 (required for multi-server dashboard) ───────────────────
# Create an app at https://discord.com/developers/applications
# Under OAuth2 > Redirects add: https://YOUR_RENDER_URL/callback
DISCORD_CLIENT_ID=your_oauth_client_id
DISCORD_CLIENT_SECRET=your_oauth_client_secret
DISCORD_REDIRECT_URI=https://YOUR_RENDER_URL/callback

# ── Bot settings ────────────────────────────────────────────────────────────
# Comma-separated list of bad words for auto-moderation
BAD_WORDS=

# Spam detection defaults (can be overridden per-server in the dashboard)
SPAM_MESSAGE_LIMIT=6
SPAM_WINDOW_SECONDS=8
SPAM_TIMEOUT_MINUTES=5

# ── Heartbeat ────────────────────────────────────────────────────────────────
HEARTBEAT_PATH=/tmp/bot_heartbeat

# NOTE: GUILD_ID is no longer required. The dashboard is now multi-server.
# Each user selects their server after logging in with Discord.
